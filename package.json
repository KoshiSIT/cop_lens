{
    "name": "cop-lens",
    "displayName": "cop-lens",
    "description": "Context-Oriented Programming debugging and visualization tools",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.104.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:javascript",
        "onCommand:cop-lens.showDependencyGraph"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "cop-lens.helloWorld",
                "title": "Hello World"
            },
            {
                "command": "cop-lens.goToLine",
                "title": "Go to Line"
            },
            {
                "command": "cop-lens.showDependencyGraph",
                "title": "COP: Show Dependency Graph",
                "icon": "$(graph)"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "copOverview",
                    "name": "COP Overview",
                    "when": "resourceExtname == .js || resourceExtname == .ts"
                }
            ]
        },
        "menus": {
            "editor/title": [
                {
                    "command": "cop-lens.showDependencyGraph",
                    "when": "resourceExtname == .js",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "cop-lens.showDependencyGraph",
                    "when": "resourceExtname == .js",
                    "group": "cop-lens"
                }
            ]
        }
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "vscode-test",
        "test:unit": "jest",
        "analyze:basic": "./analysis/dependency-cruiser/analyze-dependencies.sh basic",
        "analyze:full": "./analysis/dependency-cruiser/analyze-dependencies.sh full",
        "analyze:report": "./analysis/dependency-cruiser/analyze-dependencies.sh report",
        "analyze:validate": "./analysis/dependency-cruiser/analyze-dependencies.sh validate",
        "analyze:cop": "./analysis/dependency-cruiser/analyze-dependencies.sh cop-focus"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/test/unit/**/*.test.js",
            "**/test/integration/**/*.test.js"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/test/extension.test.js",
            "/.vscode-test/"
        ]
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.104.0",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2",
        "dependency-cruiser": "^16.10.4",
        "eslint": "^9.34.0",
        "jest": "^29.7.0"
    },
    "dependencies": {
        "acorn": "^8.15.0",
        "ws": "^8.18.0"
    }
}
